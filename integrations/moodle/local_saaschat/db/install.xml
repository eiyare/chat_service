<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/saaschat/db" VERSION="20261116" COMMENT="XMLDB file for Moodle local/saaschat"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="local_saaschat_chunks" COMMENT="Copy of the saaschat workspace's document passages">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="docid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="saaschat document ID"/>
        <FIELD NAME="docname" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="docversion" TYPE="char" LENGTH="64" NOTNULL="true" SEQUENCE="false" COMMENT="Changes whenever the passages do"/>
        <FIELD NAME="chunkindex" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="heading" TYPE="char" LENGTH="300" NOTNULL="false" SEQUENCE="false" COMMENT="Document section"/>
        <FIELD NAME="content" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="docid" UNIQUE="false" FIELDS="docid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
