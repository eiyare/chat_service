# Copy to .env and adjust. Real environment variables override values here.
#
# .env is for secrets and infrastructure (secret key, database, hosts, encryption
# key, provider credentials). Assistant behaviour (wording, persona replies,
# answering, search thresholds, chunking, workspace defaults) is managed in the
# Django admin: Settings > Platform settings, with per-workspace overrides on each
# workspace's page. The RAG_* / CHAT_* values below only seed those settings when
# the database is first created.

# --- Core ---
DJANGO_DEBUG=1
# Required when DJANGO_DEBUG=0. Generate with:
#   .venv/bin/python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_LOG_LEVEL=INFO
# Our apps' log level; defaults to DEBUG when DJANGO_DEBUG=1, else DJANGO_LOG_LEVEL.
# APP_LOG_LEVEL=
DJANGO_TIME_ZONE=UTC
DJANGO_LANGUAGE_CODE=en-us

# --- Database (defaults to SQLite in the project root) ---
DJANGO_DB_ENGINE=django.db.backends.sqlite3
DJANGO_DB_NAME=
DJANGO_DB_USER=
DJANGO_DB_PASSWORD=
DJANGO_DB_HOST=
DJANGO_DB_PORT=
DJANGO_DB_CONN_MAX_AGE=0

# --- Static files ---
DJANGO_STATIC_URL=static/
DJANGO_STATIC_ROOT=

# --- Uploaded files (private; not served over HTTP) ---
DJANGO_MEDIA_URL=media/
DJANGO_MEDIA_ROOT=

# --- Security (defaults: secure cookies on when DEBUG is off) ---
DJANGO_SESSION_COOKIE_SECURE=
DJANGO_CSRF_COOKIE_SECURE=
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SECURE_HSTS_SECONDS=0

# --- Site / tenants ---
SITE_NAME=SaaS Chat
TENANT_URL_PREFIX=t

# --- LLM models (all model calls go through LiteLLM) ---
# Everything in this section can also be managed in the Django admin
# (/admin/ > "LLM models and providers"); admin entries override these values.
# Seconds each server process caches the combined configuration:
LLM_CONFIG_CACHE_SECONDS=30
# Fernet key for API keys stored via the admin (blank = derived from DJANGO_SECRET_KEY).
# Generate: .venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LLM_ENCRYPTION_KEY=

# Model strings are "<provider>/<model>": https://docs.litellm.ai/docs/providers
# Mix providers freely; each model uses its provider's settings below.
LLM_CHAT_MODELS=ollama_chat/qwen2.5:3b,ollama_chat/llama3.2:latest
# e.g. LLM_CHAT_MODELS=ollama_chat/qwen2.5:3b,openai/gpt-4o-mini,anthropic/claude-sonnet-4-5
LLM_DEFAULT_CHAT_MODEL=ollama_chat/qwen2.5:3b
LLM_EMBED_MODEL=ollama/nomic-embed-text
# e.g. LLM_EMBED_MODEL=openai/text-embedding-3-small  (then reindex documents)
LLM_TIMEOUT=300
LLM_NUM_RETRIES=0
# Retries of temporary provider errors (busy, rate limited, timeout). Chat replies use the
# admin setting "Retries after a provider error", which this only seeds.
LLM_RETRIES=2
LLM_TEMPERATURE=
# Per-model options (JSON), layered over the provider settings:
LLM_MODEL_PARAMS=
# e.g. LLM_MODEL_PARAMS={"ollama_chat/qwen2.5:3b": {"num_ctx": 16384}}

# --- LLM providers: set only the ones you use ---
# Each provider also accepts <PROVIDER>_EXTRA_PARAMS: a JSON object of extra
# LiteLLM keyword arguments applied to all of its models.

# Ollama (models: ollama_chat/<name> for chat, ollama/<name> for embeddings)
OLLAMA_API_BASE=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_EXTRA_PARAMS={"num_ctx": 8192, "keep_alive": "5m"}

# vLLM server (models: hosted_vllm/<name>)
HOSTED_VLLM_API_BASE=
HOSTED_VLLM_API_KEY=

# Any OpenAI-compatible server: LM Studio, llama.cpp, TGI, a gateway... (models: openai_compatible/<name>)
OPENAI_COMPATIBLE_API_BASE=
OPENAI_COMPATIBLE_API_KEY=

# OpenAI (models: openai/<name>)
OPENAI_API_KEY=
OPENAI_API_BASE=
OPENAI_ORGANIZATION=

# Anthropic (models: anthropic/<name>)
ANTHROPIC_API_KEY=
ANTHROPIC_API_BASE=

# Azure OpenAI (models: azure/<deployment name>)
AZURE_API_KEY=
AZURE_API_BASE=
AZURE_API_VERSION=

# Google AI Studio (models: gemini/<name>)
GEMINI_API_KEY=

# Google Vertex AI (models: vertex_ai/<name>); credentials = path to a service-account JSON file
VERTEXAI_PROJECT=
VERTEXAI_LOCATION=
VERTEXAI_CREDENTIALS=

# AWS Bedrock (models: bedrock/<model id>)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION_NAME=

# Other hosted APIs (models: groq/<name>, mistral/<name>, cohere/<name>,
# together_ai/<name>, openrouter/<vendor>/<name>, deepseek/<name>, xai/<name>)
GROQ_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
TOGETHERAI_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=

# Add or override providers (JSON). "litellm_provider" makes a named alias,
# e.g. a second Ollama server used as models "gpu_box/<name>":
LLM_PROVIDERS_EXTRA=
# e.g. LLM_PROVIDERS_EXTRA={"gpu_box": {"litellm_provider": "ollama_chat", "api_base": "http://gpu-box:11434"}}

# --- Chat ---
CHAT_HISTORY_LIMIT=20
CHAT_MAX_MESSAGE_CHARS=8000
CHAT_TITLE_MAX_CHARS=60
CHAT_SIDEBAR_LIMIT=50
# Persona small talk (greetings, "who are you?", thanks, "what can you do?", goodbye) is
# answered without search or a model. {assistant} = chatbot name, {workspace} = workspace name.
CHAT_SMALL_TALK=1
# CHAT_GREETING_REPLY=Hi! I'm {assistant}, the assistant for {workspace}. Ask me anything about {workspace}'s documents.
# CHAT_IDENTITY_REPLY=, CHAT_THANKS_REPLY=, CHAT_HELP_REPLY=, CHAT_GOODBYE_REPLY=  (optional overrides)
# Platform-default chat token limits (each workspace can override them in the Django
# admin, Tenants). 0 = unlimited. Period: day, week or month.
CHAT_TOKEN_ALLOWANCE=0
CHAT_TOKEN_PERIOD=month
CHAT_MAX_OUTPUT_TOKENS=0
CHAT_TOKEN_LIMIT_MESSAGE=This workspace has used its token allowance for now, so I can't answer questions that need the assistant until it resets on {reset}. Questions answered by FAQs still work.

# --- RAG (knowledge base) ---
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_EMBED_BATCH_SIZE=32
# Platform defaults for workspace uploads; each workspace can override them in
# the Django admin (Tenants). Supported types: txt, pdf, md, csv, docx.
RAG_MAX_UPLOAD_MB=5
RAG_MAX_DOCUMENTS=3
RAG_ALLOWED_EXTENSIONS=txt,pdf
# Instruction prefixes some embedding models expect (empty by default). These
# example values are the ones nomic-embed-text was trained with.
# Changing the embedding model or document prefix requires: manage.py reindex_documents
RAG_QUERY_PREFIX="search_query: "
RAG_DOCUMENT_PREFIX="search_document: "

# --- Grounded chat (answers come only from workspace documents) ---
RAG_TOP_K=5
# Minimum cosine similarity for a chunk to count as relevant. Calibrate per
# embedding model: 0.52 separates on/off-topic questions well for nomic-embed-text.
RAG_MIN_SCORE=0.52
# Fraction of the question's key terms that must appear in retrieved passages
# before the model is called (0 disables; higher is stricter).
RAG_MIN_TERM_OVERLAP=0.5
# Chunks containing at least this share of the question's key terms are found even when
# embedding similarity is low (names, codes, rare terms). 0 disables.
RAG_KEYWORD_MIN_COVERAGE=0.75

# --- FAQs (managed in the Django admin) ---
# Direct FAQ answers need matching wording AND at least this embedding similarity.
RAG_FAQ_MIN_SCORE=0.8
# Close FAQs that aren't direct matches are given to the model as context.
RAG_FAQ_CONTEXT_MIN_SCORE=0.75
RAG_FAQ_CONTEXT_MAX=2
RAG_TEMPERATURE=0.1
RAG_NO_ANSWER_MESSAGE=I couldn't find that in this workspace's documents.
RAG_EMPTY_KB_MESSAGE=This workspace has no documents yet, so I can't answer questions. Upload documents from the Admin page first.
RAG_NO_EMBEDDING_MESSAGE=Document search is unavailable because no embedding model is enabled. Please ask an administrator to enable one.
RAG_NEEDS_REINDEX_MESSAGE=This workspace's documents were indexed with a different embedding model and must be reindexed before I can search them. Please ask an administrator.
# RAG_SYSTEM_PROMPT=  (optional override; supports {assistant}, {workspace} and {no_answer})

# --- Website widget ---
# Behind a reverse proxy that sets X-Forwarded-For, enable so rate limits use the visitor's IP.
WIDGET_TRUST_X_FORWARDED_FOR=0
